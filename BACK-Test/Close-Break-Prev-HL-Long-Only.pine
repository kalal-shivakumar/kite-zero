//@version=5
indicator("Kalal - Long Only", overlay=true)

buyQty  = input.int(1, "Buy Qty",  minval=1)
sellQty = input.int(1, "Sell Qty", minval=1)

// LONG ONLY: BUY (enter long) when close > previous High.
// SELL (exit long) when close < previous Low. Sell only fires while in a long position.
// STOPLOSS SELL: exit long when the buy candle's low is taken out.
var int pos = 0
var float stopLevel = na  // low of the candle that gave the buy signal

buySignal = close > high[1] and pos != 1
if buySignal
    stopLevel := low

// Stop-loss has priority; once it fires the profit-booking exit is suppressed and vice versa.
stopLossSignal = pos == 1 and low < stopLevel
exitSignal     = pos == 1 and close < low[1] and not stopLossSignal
sellSignal     = stopLossSignal or exitSignal
pos := buySignal ? 1 : sellSignal ? 0 : pos

plot(pos == 1 ? stopLevel : na, title="Stop Level", color=color.orange, style=plot.style_linebr)

plotshape(buySignal,      title="Long",      location=location.belowbar, style=shape.labelup,   color=color.green,  textcolor=color.white, text="Long")
plotshape(exitSignal,     title="Long Exit", location=location.abovebar, style=shape.labeldown, color=color.red,    textcolor=color.white, text="Long Exit")
plotshape(stopLossSignal, title="Stoploss",  location=location.abovebar, style=shape.labeldown, color=color.maroon, textcolor=color.white, text="Stoploss Triggered")

// Webhook JSON for Delta Exchange. Indicators can't use strategy.order placeholders, so side/qty are built here.
buyMsg  = '{"symbol":"{{ticker}}","side":"buy","qty":"'  + str.tostring(buyQty)  + '","trigger_time":"{{timenow}}","strategy_id":"9cf2817c0406ca0b253a547e4f7d0e8d"}'
sellMsg = '{"symbol":"{{ticker}}","side":"sell","qty":"' + str.tostring(sellQty) + '","trigger_time":"{{timenow}}","strategy_id":"9cf2817c0406ca0b253a547e4f7d0e8d"}'

if buySignal
    alert(buyMsg, alert.freq_once_per_bar)

if sellSignal
    alert(sellMsg, alert.freq_once_per_bar)

alertcondition(buySignal,      "BUY Signal",      "BUY: Close above previous High")
alertcondition(exitSignal,     "SELL Signal",     "SELL: Close below previous Low (exit long)")
alertcondition(stopLossSignal, "STOPLOSS Signal", "STOPLOSS SELL: Buy candle low taken out")
