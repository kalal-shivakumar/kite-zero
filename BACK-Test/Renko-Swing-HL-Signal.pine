//@version=5
indicator("Renko Swing HL Signal", overlay=true)

len = input.int(2, "Swing Length", minval=1)
buyQty  = input.int(1, "Buy Qty",  minval=1)
sellQty = input.int(1, "Sell Qty", minval=1)

// Confirmed swing points (pivot forms 'len' bars back).
ph = ta.pivothigh(high, len, len)
pl = ta.pivotlow(low, len, len)

var float prevLow  = na
var float curLow   = na
var float prevHigh = na
var float curHigh  = na
var bool  pendBuy  = false
var bool  pendSell = false
var int   pos      = 0

// Renko brick color.
greenBrick = close > open
redBrick   = close < open

buySignal  = false
sellSignal = false

// Step 1 - every new swing low re-compares with the previous swing low (higher/equal low arms BUY, else cancels).
if not na(pl)
    prevLow := curLow
    curLow  := pl
    if not na(prevLow)
        pendBuy := curLow >= prevLow

// Step 1 - every new swing high re-compares with the previous swing high (lower/equal high arms SELL, else cancels).
if not na(ph)
    prevHigh := curHigh
    curHigh  := ph
    if not na(prevHigh)
        pendSell := curHigh <= prevHigh

// Step 2 - confirm with one brick in the signal direction. Alternate BUY/SELL only.
if pendBuy and greenBrick and pos != 1
    buySignal := true
    pendBuy   := false
    pos       := 1

if pendSell and redBrick and pos != -1
    sellSignal := true
    pendSell   := false
    pos        := -1

plotshape(buySignal,  title="BUY",  location=location.belowbar, style=shape.triangleup,   color=color.green, text="BUY")
plotshape(sellSignal, title="SELL", location=location.abovebar, style=shape.triangledown, color=color.red,   text="SELL")

// Webhook JSON for Delta Exchange. Indicators can't use strategy.order placeholders, so side/qty are built here.
buyMsg  = '{"symbol":"{{ticker}}","side":"buy","qty":"'  + str.tostring(buyQty)  + '","trigger_time":"{{timenow}}","strategy_id":"9cf2817c0406ca0b253a547e4f7d0e8d"}'
sellMsg = '{"symbol":"{{ticker}}","side":"sell","qty":"' + str.tostring(sellQty) + '","trigger_time":"{{timenow}}","strategy_id":"9cf2817c0406ca0b253a547e4f7d0e8d"}'

if buySignal
    alert(buyMsg, alert.freq_once_per_bar)

if sellSignal
    alert(sellMsg, alert.freq_once_per_bar)

alertcondition(buySignal,  "BUY Signal",  "BUY: Higher/equal swing low")
alertcondition(sellSignal, "SELL Signal", "SELL: Lower/equal swing high")
